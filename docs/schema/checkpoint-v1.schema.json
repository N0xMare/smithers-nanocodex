{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://n0xmare.github.io/smithers-nanocodex/schema/checkpoint-v1.schema.json",
  "$comment": "The $id is a stable protocol-v1 identity URI and is not required to resolve. 0.0.2 still uses this v1 identity; payload.nanocodexVersion is const 0.5.0 on the same envelope.",
  "title": "Smithers Nanocodex checkpoint envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["codec", "version", "payload"],
  "properties": {
    "codec": { "const": "nanocodex.session-snapshot" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bridgeProtocolVersion",
        "nanocodexVersion",
        "snapshotVersion",
        "canonicalWorkspace",
        "policyFingerprint",
        "nanocodexSnapshot"
      ],
      "properties": {
        "bridgeProtocolVersion": { "const": 1 },
        "nanocodexVersion": { "const": "0.5.0" },
        "snapshotVersion": { "const": 1 },
        "canonicalWorkspace": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/[^\\u0000]*$"
        },
        "policyFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "nanocodexSnapshot": {
          "type": "object"
        }
      }
    }
  }
}
